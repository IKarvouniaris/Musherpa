# Supabase project URL and publishable ("anon") key.
# Safe to expose in the browser bundle — access is enforced by Postgres
# Row Level Security policies (see supabase/migrations), not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key (aistudio.google.com). SERVER-ONLY — used exclusively from
# lib/gemini/client.ts (guarded by the "server-only" package), never sent to
# the browser. Get it as GEMINI_API_KEY at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Reserved for later phases. SERVER-ONLY — never prefix with NEXT_PUBLIC_,
# never import from client code, never commit a real value here.
# SUPABASE_SERVICE_ROLE_KEY=
